# 토스페이먼츠 (테스트 모드 전용)
# 실제 키 값은 .env 에만 넣으세요. .env 는 git 에 커밋되지 않습니다.
# test_ 로 시작하는 키만 허용됩니다. live_ 키는 앱에서 거부합니다.

# 브라우저에 노출되는 클라이언트 키 (결제창 실행용)
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# 서버 전용 시크릿 키 (결제 승인/취소용) — 절대 클라이언트에 노출 금지
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# 주문 무결성 서명용 키 (프로토타입: 주문 금액 위조 방지 HMAC)
ORDER_SIGNING_SECRET=change-me-random-32-chars

# 외부 Supabase 프로젝트 (mintondong / ref tkumfwiomcxkdbzljyss)
# Lovable Cloud 는 사용하지 않습니다.
VITE_SUPABASE_URL=https://tkumfwiomcxkdbzljyss.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
SUPABASE_URL=https://tkumfwiomcxkdbzljyss.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
# 서버 전용(선택, 관리자 작업에만 사용)
SUPABASE_SERVICE_ROLE_KEY=service_role_key
