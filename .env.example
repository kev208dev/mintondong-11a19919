# 토스페이먼츠 (테스트 모드 전용)
# 실제 키 값은 .env 에만 넣으세요. .env 는 git 에 커밋되지 않습니다.
# test_ 로 시작하는 키만 허용됩니다. live_ 키는 앱에서 거부합니다.

# 브라우저에 노출되는 클라이언트 키 (결제창 실행용)
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# 서버 전용 시크릿 키 (결제 승인/취소용) — 절대 클라이언트에 노출 금지
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# 주문 무결성 서명용 키 (프로토타입: 주문 금액 위조 방지 HMAC)
ORDER_SIGNING_SECRET=change-me-random-32-chars

# PortOne V2 / KG이니시스
# 브라우저 공개 식별값 — 결제창 호출에 사용되며 secret이 아닙니다.
VITE_PORTONE_STORE_ID=store-81345dbd-4a7e-49ce-b68f-f1c9465294c2
VITE_PORTONE_CHANNEL_KEY=channel-key-f8da7be3-4a42-4e83-a7a9-f5926b6fec7d
VITE_PORTONE_ENABLED=true
# 서버 전용 secret — VITE_ 접두사를 붙이거나 클라이언트 코드에서 참조하지 마세요.
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# 외부 Supabase 프로젝트 (mintondong / ref tkumfwiomcxkdbzljyss)
VITE_SUPABASE_URL=https://tkumfwiomcxkdbzljyss.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
SUPABASE_URL=https://tkumfwiomcxkdbzljyss.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
# 서버 전용(회원가입, 공개 레슨, 결제 검증에 필요, 브라우저 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=service_role_key

# 공개 사업자/법적 정보 (PG 심사 전 실제 값으로 모두 입력)
# 아래 값은 브라우저에 공개됩니다. 확인된 실사업자 정보만 넣으세요.
VITE_BUSINESS_NAME=
VITE_BUSINESS_REPRESENTATIVE_NAME=
VITE_BUSINESS_REGISTRATION_NUMBER=
VITE_BUSINESS_ADDRESS=
VITE_CUSTOMER_SERVICE_PHONE=
VITE_CUSTOMER_SERVICE_EMAIL=
# 해당하는 경우에만 입력
VITE_ECOMMERCE_REGISTRATION_NUMBER=
# 약관/개인정보처리방침 시행일 (예: YYYY-MM-DD)
VITE_POLICY_EFFECTIVE_DATE=

# 운영 확정된 문구만 입력. 미입력 시 결제 화면에 심사 준비 미완료로 표시됩니다.
VITE_REFUND_CANCELLATION_DEADLINE=
VITE_REFUND_EXPECTED_PROCESSING_PERIOD=

# 실제 Supabase Dashboard에서 provider 자격증명 설정을 마친 뒤에만 true
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_APPLE_LOGIN=true

# Sign in with Apple 계정 삭제 token revocation — 모두 Worker server-only 값입니다.
# APPLE_PRIVATE_KEY는 Cloudflare Runtime Secret으로 등록하고 VITE_를 붙이지 않습니다.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=
# Apple Developer의 server-to-server endpoint가 연결된 Primary App ID.
# Services ID인 APPLE_CLIENT_ID와 구분하며 Worker server에서만 검증에 사용합니다.
APPLE_NOTIFICATION_AUDIENCE=com.mintondong.app

# 대회 수집 (모두 Cloudflare Worker runtime secret/variable, VITE_ 금지)
# POST /api/tournaments/sync 인증용. 충분히 긴 무작위 secret을 Worker Secret으로 등록합니다.
TOURNAMENT_SYNC_SECRET=
# 외부 서비스의 서면 허가/이용 조건을 확인한 source만 true로 활성화합니다.
TOURNAMENT_FACECOCK_ENABLED=false
TOURNAMENT_COURTX_ENABLED=false
